---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<div class="content">
			<h1>r4ppz</h1>
			<p class="tagline">student / linux user</p>
			<div class="links">
				<a
					href="https://github.com/r4ppz"
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:github" width="20" height="20" />
					github.com/r4ppz
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.content {
		text-align: center;
		max-width: 600px;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, #fafafa 0%, #a1a1aa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		font-size: 1.125rem;
		color: #a1a1aa;
		margin-bottom: 1.5rem;
		font-weight: 400;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: #a1a1aa;
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0.6rem 1.2rem;
		border: 1px solid #27272a;
		border-radius: 8px;
		transition:
			border-color 0.2s,
			color 0.2s;
	}

	.links a:hover {
		border-color: #fafafa;
		color: #fafafa;
	}
</style>
